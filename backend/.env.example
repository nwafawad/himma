# Server Configuration
PORT=8000
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# File uploads (mount this directory persistently in production when using local storage)
UPLOAD_DIR=uploads

# Database Configuration (Local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/momentum_db"

# JWT Authentication Configuration
JWT_SECRET=momentum-dev-jwt-secret-key-32chars!
JWT_EXPIRES_IN=7d

# Google Gemini AI Configuration (@google/genai)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
